#!name=AkileCloud 签到
#!desc=每日签到 · 账号登录
#!author=凉心
#!homepage=https://github.com/52Lxcloud/ScriptKit
#!icon=https://raw.githubusercontent.com/52Lxcloud/ScriptKit/dev/Icons/akile.png
#!tag=凉心Tools
#!date=2026-06-26 14:58:14

[Argument]
CronExp = input,"30 7 * * *",tag=签到时间,desc=签到时间 (Cron 表达式)
Accounts = input,"email:pass",tag=账号列表,desc=账号列表 (格式: 邮箱:密码，多个用 ; 分隔)
LogLevel = select,"info","off","error","warn","debug","all",tag=日志级别,desc=off/error/warn/info/debug/all (排查问题时填 debug)

[Script]
cron {CronExp} script-path=https://raw.githubusercontent.com/52Lxcloud/ScriptKit/dev/Scripts/akile.js, tag=Akile_Checkin, argument=[{Accounts},{LogLevel}], timeout=60, enable=true
