#!name=AkileCloud 签到
#!desc=每日签到 · 账号登录
#!author=凉心
#!homepage=https://github.com/52Lxcloud/Scripts-dev
#!date=2026-06-25 21:28:34

[Argument]
CronExp = input,"30 7 * * *",tag=CronExp,desc=签到时间 (Cron 表达式)
Accounts = input,"email:pass",tag=Accounts,desc=账号列表 (格式: 邮箱:密码，多个用 ; 分隔)
LogLevel = select,"info","off","error","warn","debug","all",tag=LogLevel,desc=日志级别 off/error/warn/info/debug/all (排查问题时填 debug)

[Script]
cron {CronExp} script-path=https://raw.githubusercontent.com/52Lxcloud/ScriptKit/main/Scripts/akile.js, tag=Akile_Checkin, argument=[{Accounts},{LogLevel}], timeout=60, enable=true
