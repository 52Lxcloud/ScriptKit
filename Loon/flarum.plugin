#!name=Flarum 签到
#!desc=每日签到 · 账号登录 · 多站点
#!author=凉心
#!homepage=https://github.com/52Lxcloud/ScriptKit
#!icon=https://raw.githubusercontent.com/52Lxcloud/ScriptKit/main/Icons/flarum.png
#!tag=凉心Tools
#!date=2026-06-26 14:58:14

[Argument]
CronExp = input,"10 8 * * *",tag=签到时间,desc=签到时间 (Cron 表达式)
Sites = input,"xxx.com",tag=域名列表,desc=域名列表 (多个用 ; 分隔)
Accounts = input,"user:pass",tag=账号列表,desc=账号列表 (格式: 用户名:密码，多个用 ; 分隔，与域名顺序对应)
LogLevel = select,"info","off","error","warn","debug","all",tag=日志级别,desc=off/error/warn/info/debug/all (排查问题时填 debug)

[Script]
cron {CronExp} script-path=https://raw.githubusercontent.com/52Lxcloud/ScriptKit/main/Scripts/flarum.js, tag=Flarum_Checkin, argument=[{Sites},{Accounts},{LogLevel}], timeout=60, enable=true
