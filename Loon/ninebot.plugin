#!name=九号出行 签到
#!desc=自动签到领N币 · Token 抓取
#!author=凉心
#!homepage=https://github.com/52Lxcloud/Scripts-dev
#!date=2026-06-25 21:28:34

[Argument]
CronExp = input,"10 8 * * *",tag=CronExp,desc=签到时间 (Cron 表达式)
LogLevel = select,"info","off","error","warn","debug","all",tag=LogLevel,desc=日志级别 off/error/warn/info/debug/all (排查问题时填 debug)

[Script]
http-request ^https:\/\/cn-cbu-gateway\.ninebot\.com\/(portal|app-api)\/api\/user-sign\/ script-path=https://raw.githubusercontent.com/52Lxcloud/ScriptKit/main/Scripts/ninebot.js, tag=Ninebot_Header, argument=[{LogLevel}], requires-body=false, enable=true
cron {CronExp} script-path=https://raw.githubusercontent.com/52Lxcloud/ScriptKit/main/Scripts/ninebot.js, tag=Ninebot_Checkin, argument=[{LogLevel}], timeout=60, enable=true

[MITM]
hostname = cn-cbu-gateway.ninebot.com
