[task_local]
10 0 * * * https://raw.githubusercontent.com/52Lxcloud/ScriptKit/main/Scripts/v2ex.js, tag=V2EX 签到, enabled=true

[rewrite_local]
^https?:\/\/www\.v2ex\.com\/member\/.* url script-request-header https://raw.githubusercontent.com/52Lxcloud/ScriptKit/main/Scripts/v2ex.js

[mitm]
hostname = %APPEND% www.v2ex.com
