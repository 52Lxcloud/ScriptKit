name: 'AkileCloud 签到'
desc: '每日签到 · 账号登录'
author: '凉心'
category: '凉心Tools'
homepage: 'https://github.com/52Lxcloud/ScriptKit'
date: '2026-06-26 14:58:14'
version: '1.0.1'

cron:
  script:
    - name: Akile
      cron: '30 7 * * *'
      argument: 'Accounts=email:pass&LogLevel=info'
      timeout: 60

script-providers:
  Akile:
    url: https://raw.githubusercontent.com/52Lxcloud/ScriptKit/dev/Scripts/akile.js
    interval: 86400
