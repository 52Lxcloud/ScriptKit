name: 'Flarum 签到'
desc: '每日签到 · 账号登录 · 多站点'
author: '凉心'
category: '凉心Tools'
homepage: 'https://github.com/52Lxcloud/Scripts-dev'
date: '2026-06-25 21:28:34'
version: '1.0.3'

cron:
  script:
    - name: Flarum
      cron: '10 8 * * *'
      argument: 'Sites=xxx.com&Accounts=user:pass&LogLevel=info'
      timeout: 60

script-providers:
  Flarum:
    url: https://raw.githubusercontent.com/52Lxcloud/ScriptKit/main/Scripts/flarum.js
    interval: 86400
