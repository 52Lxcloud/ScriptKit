#!name=九号出行 签到
#!desc=自动签到领N币 · Token 抓取
#!author=凉心
#!category=凉心Tools
#!date=2026-06-26 11:43:55
#!arguments=CronExp:10 8 * * *,LogLevel:info
#!arguments-desc=CronExp:签到时间 (Cron 表达式)\nLogLevel:日志级别 off/error/warn/info/debug/all (排查问题时填 debug)

[Script]
Ninebot_Header=type=http-request,pattern=^https:\/\/cn-cbu-gateway\.ninebot\.com\/(portal|app-api)\/api\/user-sign\/,requires-body=0,max-size=0,script-path=https://raw.githubusercontent.com/52Lxcloud/ScriptKit/main/Scripts/ninebot.js,argument="LogLevel={{{LogLevel}}}"
Ninebot_Checkin=type=cron,cronexp="{{{CronExp}}}",wake-system=1,timeout=60,script-path=https://raw.githubusercontent.com/52Lxcloud/ScriptKit/main/Scripts/ninebot.js,argument="LogLevel={{{LogLevel}}}"

[MITM]
hostname = %APPEND% cn-cbu-gateway.ninebot.com
