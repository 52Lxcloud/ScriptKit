#!name=Nodeseek 签到
#!desc=自动签到领鸡腿 · Headers 抓取
#!author=凉心
#!category=凉心Tools
#!date=2026-06-25 21:28:34
#!arguments=CronExp:07 0 * * *,USER_ID:[0-9]+,LogLevel:info
#!arguments-desc=CronExp:签到时间 (Cron 表达式)\nUSER_ID:用户UID\n点击头像进入个人主页链接/space后的数字为用户UID\nLogLevel:日志级别 off/error/warn/info/debug/all (排查问题时填 debug)

[Script]
Nodeseek_Header=type=http-request,pattern=^https:\/\/www\.nodeseek\.com\/api\/account\/getInfo\/{{{USER_ID}}}\?readme=1$,requires-body=0,max-size=0,script-path=https://raw.githubusercontent.com/52Lxcloud/ScriptKit/main/Scripts/nodeseek.js,argument="USER_ID={{{USER_ID}}}&LogLevel={{{LogLevel}}}"
Nodeseek_Checkin=type=cron,cronexp="{{{CronExp}}}",wake-system=1,timeout=60,script-path=https://raw.githubusercontent.com/52Lxcloud/ScriptKit/main/Scripts/nodeseek.js,argument="USER_ID={{{USER_ID}}}&LogLevel={{{LogLevel}}}"

[MITM]
hostname = %APPEND% www.nodeseek.com
